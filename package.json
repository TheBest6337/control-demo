{
  "name": "qitech-control-demo",
  "productName": "QiTech Control Demo",
  "version": "0.1.0",
  "description": "QiTech Control operator UI in the browser, driven by machines simulated in the page",
  "private": true,
  "license": "LGPL-3.0-only",
  "type": "module",
  "bin": {
    "control-demo": "dist-server/main.js"
  },
  "files": [
    "dist-server",
    "ui/dist"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite --config ui/vite.config.ts",
    "build": "npm run build:ui && npm run build:server",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "preview": "vite preview --config ui/vite.config.ts",
    "start": "node dist-server/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p backend/tsconfig.json",
    "format": "prettier --check server backend test scripts",
    "format:write": "prettier --write server backend test scripts"
  },
  "overrides": {
    "glob": "^13.0.0"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@icons-pack/react-simple-icons": "^13.12.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.4",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toggle": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.168.10",
    "@tanstack/react-table": "^8.21.2",
    "@tanstack/router-devtools": "^1.167.2",
    "@types/node": "^24.2.1",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "@types/react-virtualized": "^9.22.2",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.2",
    "immer": "^11.1.4",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.22.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "6.4.299",
    "postcss": "^8.5.25",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.57.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-virtualized": "^9.22.6",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "uplot": "^1.6.32",
    "vite": "^8.1.5",
    "vitest": "^4.1.12",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.5",
    "zod-validation-error": "^5.0.0",
    "zustand": "^5.0.15"
  }
}
